APP_ENV=development
APP_NAME=可信监管 RAG 系统
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 本机开发默认 SQLite；Docker Compose 会覆盖为 PostgreSQL。
DATABASE_URL=sqlite:///./data/runtime/trusted_rag.db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=regulatory_knowledge

# 甲方原始数据目录。Docker 中固定映射到 /data/raw。
SOURCE_DATA_DIR=../nfra_page_attachments_500
QA_WORKBOOK_PATH=../QA数据.xlsx
DERIVED_DATA_DIR=./data/derived

# local | cloud | disabled
LLM_PROVIDER=disabled
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0

EMBEDDING_PROVIDER=disabled
EMBEDDING_BASE_URL=http://localhost:8002/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=32
HYBRID_CANDIDATE_COUNT=40

POSTGRES_DB=trusted_rag
POSTGRES_USER=trusted_rag
POSTGRES_PASSWORD=change-me
